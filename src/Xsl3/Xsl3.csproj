<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Xsl3</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Xsl3</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.0.1-alpha</Version>
    <Description>An XSLT 2.0 / 3.0 processor for .NET, forked from System.Xml.Xsl (XslCompiledTransform). Drop-in compatible with XslCompiledTransform for XSLT 1.0.</Description>
    <!-- Upstream code predates some analyzers; keep the fork's diff against upstream small. -->
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1309;CA1310;CA1311;CA1416;CA1510;CA1512;CA1513;CA1822;CA1825;CA1834;CA1845;CA1846;CA1847;CA1854;CA1859;CA1861;CA1865;CA1866;CA1867;CA2208;CA2249;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.TXT" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xsl3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>Xsl3.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The .p files are the optimizer's original pattern-language sources; documentation only (SPEC §3.2.1). -->
    <None Include="Xsl\**\*.p" />
  </ItemGroup>

</Project>
