<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Xsl3</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Xsl3</PackageId>
    <Title>Xsl3: XSLT 3.0, XSLT 2.0 and XPath 3.1 for .NET</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.0.1-alpha</Version>
    <Description>XSLT 3.0, XSLT 2.0 and XPath 3.1 processor for .NET, compiled to IL. Built on the engine behind System.Xml.Xsl.XslCompiledTransform and keeps its API, so XSLT 1.0 stylesheets run unchanged with identical output. Adds maps, arrays and higher-order functions, xsl:try, xsl:iterate, xsl:merge, accumulators, packages, JSON functions and json/adaptive/HTML5 output. Alpha: xsl:evaluate, schema awareness and streaming aren't supported yet.</Description>
    <!-- Upstream code predates some analyzers; keep the fork's diff against upstream small. -->
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1309;CA1310;CA1311;CA1416;CA1510;CA1512;CA1513;CA1822;CA1825;CA1834;CA1845;CA1846;CA1847;CA1854;CA1859;CA1861;CA1865;CA1866;CA1867;CA2208;CA2249;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package page's readme: docs/nuget/README.md (absolute links), not the repository's README. -->
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.TXT" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xsl3.Tests" />
    <InternalsVisibleTo Include="Xsl3.W3C" />
    <InternalsVisibleTo Include="Xsl3.Dev" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>Xsl3.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The .p files are the optimizer's original pattern-language sources; documentation only (SPEC §3.2.1). -->
    <None Include="Xsl\**\*.p" />
  </ItemGroup>

</Project>
