<xsl:stylesheet version='3.0' xmlns:xsl='http://www.w3.org/1999/XSL/Transform' xmlns:xs='http://www.w3.org/2001/XMLSchema' exclude-result-prefixes='xs'><xsl:mode streamable='yes' use-accumulators='total'/><xsl:accumulator name='total' as='xs:integer' initial-value='0' streamable='yes'><xsl:accumulator-rule match='row' phase='end' select='$value + xs:integer(@amount)'/></xsl:accumulator><xsl:output method='text' omit-xml-declaration='yes' encoding='utf-8' byte-order-mark='no'/><xsl:template match='/'><xsl:value-of select="accumulator-after('total')"/></xsl:template></xsl:stylesheet>