<xsl:stylesheet version='3.0' xmlns:xsl='http://www.w3.org/1999/XSL/Transform' xmlns:xs='http://www.w3.org/2001/XMLSchema' exclude-result-prefixes='xs'><xsl:mode streamable='yes' on-no-match='shallow-copy'/><xsl:output method='text' omit-xml-declaration='yes' encoding='utf-8' byte-order-mark='no'/><xsl:template match='/'><xsl:iterate select='doc/row'><xsl:param name='balance' as='xs:integer' select='0'/><xsl:on-completion select='$balance'/><xsl:next-iteration><xsl:with-param name='balance' select='$balance + xs:integer(@amount)'/></xsl:next-iteration></xsl:iterate></xsl:template></xsl:stylesheet>