<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Generate the saved entry points before building; see eng/publish-stream-probe.sh. -->
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1310;CA1311</NoWarn>
  </PropertyGroup>
  <Target Name="CheckProbeInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ProbeStylesheetDirectory)/StreamingProbe.Native.g.cs')" Text="Generate saved probe entry points with eng/publish-stream-probe.sh first." />
  </Target>
  <ItemGroup>
    <!-- Bind the same Unix RSS counter directly instead of the managed library-name search. -->
    <DirectPInvoke Include="libc!getrusage" Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))" />
    <ProjectReference Include="../../src/Xsl3/Xsl3.csproj" />
    <Reference Include="$(ProbeStylesheetDirectory)/*.dll" />
    <Compile Include="$(ProbeStylesheetDirectory)/StreamingProbe.Native.g.cs" Link="StreamingProbe.Native.g.cs" />
    <Compile Include="../Xsl3.Tests/ProbeSha256.cs" Link="ProbeSha256.cs" />
    <Compile Include="../Xsl3.Tests/StreamingProbe.cs" Link="StreamingProbe.cs" />
    <Compile Include="../Xsl3.Tests/StreamingProbe.Memory.cs" Link="StreamingProbe.Memory.cs" />
    <Compile Include="../Xsl3.Tests/StreamingProbe.Stylesheets.cs" Link="StreamingProbe.Stylesheets.cs" />
    <Compile Include="../Xsl3.Tests/StreamingProbe.Json.cs" Link="StreamingProbe.Json.cs" />
  </ItemGroup>
</Project>
